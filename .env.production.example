# Set image tags to the tested 40-character Git commit SHA before first startup.
FRONTEND_IMAGE=ghcr.io/yurigolev/setlist-front-pwa:REPLACE_WITH_COMMIT_SHA
BACKEND_IMAGE=ghcr.io/yurigolev/setlist-back:REPLACE_WITH_COMMIT_SHA
HTTP_BIND=0.0.0.0
HTTP_PORT=80
PWA_ORIGIN=http://135.106.172.166
POSTGRES_USER=setlist
# Use independently generated hexadecimal passwords (URL-safe for DATABASE_URL).
POSTGRES_PASSWORD=
POSTGRES_DB=setlist
MINIO_ROOT_USER=setlist
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=setlist-files
MAX_IMAGE_BYTES=10485760
MAX_MP3_BYTES=52428800
