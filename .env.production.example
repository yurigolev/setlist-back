# Set image tags to the tested 40-character Git commit SHA before first startup.
FRONTEND_IMAGE=ghcr.io/yurigolev/setlist-front-pwa:REPLACE_WITH_COMMIT_SHA
BACKEND_IMAGE=ghcr.io/yurigolev/setlist-back:REPLACE_WITH_COMMIT_SHA
APP_DOMAIN=setlivo.ru
PWA_ORIGIN=https://setlivo.ru
# Ordered Docker DNS service names, nearest API first (Nginx, then Caddy).
TRUSTED_PROXY_CHAIN=frontend,caddy
POSTGRES_USER=setlist
# Use independently generated hexadecimal passwords (URL-safe for DATABASE_URL).
POSTGRES_PASSWORD=
POSTGRES_DB=setlist
MINIO_ROOT_USER=setlist
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=setlist-files
MAX_IMAGE_BYTES=10485760
MAX_MP3_BYTES=52428800

# Authentication lifetime (seconds); existing sessions keep their original expiry.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=https://setlivo.ru/v1/auth/telegram/callback
AUTH_SESSION_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=7776000
