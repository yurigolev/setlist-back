POSTGRES_USER=setlist
POSTGRES_PASSWORD=
POSTGRES_DB=setlist
MINIO_ROOT_USER=setlist
MINIO_ROOT_PASSWORD=
PWA_ORIGIN=https://example.com
API_PORT=3000
PORT=3000
# Empty for direct host development; production uses frontend,caddy.
TRUSTED_PROXY_CHAIN=
DATABASE_URL=
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=setlist
MINIO_SECRET_KEY=
MINIO_BUCKET=setlist-files
MAX_IMAGE_BYTES=10485760
MAX_MP3_BYTES=52428800

# Yandex OAuth: server-only credentials, exact registered callback URL.
# Missing credentials fail closed. Real values must never be committed.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:5173/v1/auth/yandex/callback
AUTH_ALLOW_INSECURE_LOCAL_HTTP=true
AUTH_SESSION_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=7776000
# Fill both with an explicitly verified issuer/sub; use the server-verified Yandex id, never email/login or the first visitor.
# LEGACY_OWNER_YANDEX_ISSUER=https://login.yandex.ru
# LEGACY_OWNER_YANDEX_SUB=
