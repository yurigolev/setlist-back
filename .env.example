POSTGRES_USER=setlist
POSTGRES_PASSWORD=
POSTGRES_DB=setlist
MINIO_ROOT_USER=setlist
MINIO_ROOT_PASSWORD=
PWA_ORIGIN=https://example.com
API_PORT=3000
PORT=3000
# Empty for direct host development; production uses frontend,caddy.
TRUSTED_PROXY_CHAIN=
DATABASE_URL=
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=setlist
MINIO_SECRET_KEY=
MINIO_BUCKET=setlist-files
MAX_IMAGE_BYTES=10485760
MAX_MP3_BYTES=52428800

# Telegram OIDC: server-only credentials, exact registered callback URL.
# Missing credentials fail closed. Real values must never be committed.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=http://localhost:5173/v1/auth/telegram/callback
AUTH_ALLOW_INSECURE_LOCAL_HTTP=true
AUTH_SESSION_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=7776000
# Fill both with an explicitly verified issuer/sub; never use profile.id or first visitor.
# LEGACY_OWNER_TELEGRAM_ISSUER=https://oauth.telegram.org
# LEGACY_OWNER_TELEGRAM_SUB=
